# ================================================================
# configs/040md.config —— 040MD 增量配置（叠加在上游机型 config 之上）
# build-040md.yml 在 "Load custom configuration" 之后 append 进 .config。
# 只写差异项；上游 configs/nokia_xg-040g-md-ubi.config 保持原样。
# ================================================================

# 科学上网
CONFIG_PACKAGE_luci-app-openclash=y

# VPN
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier-noweb=y

# 功能插件
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-owq-wol=y

# 认证
CONFIG_PACKAGE_luci-app-gecoosac=y

# 主题
CONFIG_PACKAGE_luci-theme-vantage=y
