#!/bin/sh
# 040MD 默认值：LAN 192.168.8.1 + 默认主题 Vantage
# 注意：改 ipaddr 必须同时把 DHCP 池挪进新网段，否则客户端拿到旧网段地址
uci -q batch <<'UCI'
set network.lan.ipaddr='192.168.8.1'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set luci.main.mediaurlbase='/luci-static/vantage'
set luci.themes.Vantage='/luci-static/vantage'
commit network
commit dhcp
commit luci
UCI
exit 0
